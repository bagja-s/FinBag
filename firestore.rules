rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['baseCurrency', 'language']) &&
        data.baseCurrency is string && data.baseCurrency.size() <= 10 &&
        data.language is string && data.language.size() <= 10;
    }

    function isValidWallet(data, userId) {
      return data.keys().hasAll(['name', 'type', 'balance', 'currency', 'userId']) &&
        data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.type in ['cash', 'bank', 'ewallet', 'investment'] &&
        data.balance is number &&
        data.currency is string && data.currency.size() <= 5;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['date', 'amount', 'currency', 'type', 'sourceWalletId', 'description', 'userId']) &&
        data.userId == userId &&
        data.date is string && data.date.size() <= 20 &&
        data.amount is number &&
        data.currency is string && data.currency.size() <= 5 &&
        data.type in ['expense', 'income', 'transfer'] &&
        data.sourceWalletId is string && data.sourceWalletId.size() <= 128 &&
        data.description is string && data.description.size() <= 200;
    }

    function isValidBudget(data, userId) {
      return data.keys().hasAll(['categoryName', 'monthlyLimit', 'currency', 'userId']) &&
        data.userId == userId &&
        data.categoryName is string && data.categoryName.size() <= 100 &&
        data.monthlyLimit is number &&
        data.currency is string && data.currency.size() <= 5;
    }

    function isValidGoal(data, userId) {
      return data.keys().hasAll(['title', 'targetAmount', 'currentAmount', 'currency', 'userId']) &&
        data.userId == userId &&
        data.title is string && data.title.size() <= 100 &&
        data.targetAmount is number &&
        data.currentAmount is number &&
        data.currency is string && data.currency.size() <= 5;
    }

    // User document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile(incoming());
      allow delete: if isOwner(userId);

      // Wallets subcollection
      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(walletId) && isValidWallet(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(walletId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(budgetId) && isValidBudget(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(goalId) && isValidGoal(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }
    }
  }
}
