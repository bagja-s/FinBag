{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile metadata, roles, status, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["creator", "admin", "user"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "lastLoginAt": { "type": "string", "maxLength": 50 },
        "baseCurrency": { "type": "string", "maxLength": 5 },
        "language": { "type": "string", "maxLength": 5 },
        "theme": { "type": "string", "maxLength": 10 }
      },
      "required": ["uid", "email"]
    },
    "wallet": {
      "title": "Wallet",
      "description": "Financial wallet or account such as Cash, Bank, or E-Wallet",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["cash", "bank", "ewallet", "credit", "investment"] },
        "balance": { "type": "number" },
        "initialBalance": { "type": "number" },
        "currency": { "type": "string", "maxLength": 5 },
        "color": { "type": "string", "maxLength": 30 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "type", "balance", "currency", "userId"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Income, expense, or transfer transaction record",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 5 },
        "exchangeRateToBase": { "type": "number" },
        "type": { "type": "string", "enum": ["expense", "income", "transfer"] },
        "categoryId": { "type": "string", "maxLength": 50 },
        "sourceWalletId": { "type": "string", "maxLength": 128 },
        "targetWalletId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "recurringRuleId": { "type": "string", "maxLength": 128 }
      },
      "required": ["date", "amount", "currency", "type", "sourceWalletId", "description", "userId"]
    },
    "recurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Automatic recurring transaction schedule rule",
      "type": "object",
      "properties": {
        "description": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 5 },
        "type": { "type": "string", "enum": ["expense", "income", "transfer"] },
        "categoryId": { "type": "string", "maxLength": 50 },
        "sourceWalletId": { "type": "string", "maxLength": 128 },
        "targetWalletId": { "type": "string", "maxLength": 128 },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] },
        "startDate": { "type": "string", "maxLength": 20 },
        "nextRunDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "lastRunDate": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["description", "amount", "currency", "type", "sourceWalletId", "frequency", "startDate", "nextRunDate", "active", "userId"]
    },
    "budget": {
      "title": "Budget",
      "description": "Monthly budget limit per expense category",
      "type": "object",
      "properties": {
        "categoryName": { "type": "string", "maxLength": 100 },
        "monthlyLimit": { "type": "number" },
        "currency": { "type": "string", "maxLength": 5 },
        "icon": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 30 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["categoryName", "monthlyLimit", "currency", "userId"]
    },
    "goal": {
      "title": "Goal",
      "description": "Savings goal target pot",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 5 },
        "targetDate": { "type": "string", "maxLength": 20 },
        "color": { "type": "string", "maxLength": 30 },
        "icon": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["title", "targetAmount", "currentAmount", "currency", "userId"]
    },
    "debtRecord": {
      "title": "DebtRecord",
      "description": "Debt (payable) or receivable record tracked by the user",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["payable", "receivable"] },
        "personName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 5 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["unpaid", "settled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["type", "personName", "title", "amount", "currency", "status", "userId"]
    },
    "auditLog": {
      "title": "AuditLog",
      "description": "Immutable change history log for data auditing and security",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE", "TRANSFER", "CLEAR"] },
        "entity": { "type": "string", "enum": ["TRANSACTION", "WALLET", "GOAL", "BUDGET", "DEBT", "DATABASE", "SECURITY"] },
        "summary": { "type": "string", "maxLength": 250 },
        "details": { "type": "object" }
      },
      "required": ["userId", "timestamp", "action", "entity", "summary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Stores user profile and preferences"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": "wallet",
      "description": "Stores accounts and wallets owned by the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Stores transaction ledger entries for the user"
    },
    "/users/{userId}/recurring_transactions/{recurringId}": {
      "schema": "recurringTransaction",
      "description": "Stores automatic recurring transaction schedules for the user"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "budget",
      "description": "Stores budget targets for the user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "goal",
      "description": "Stores financial savings goals for the user"
    },
    "/users/{userId}/debts/{debtId}": {
      "schema": "debtRecord",
      "description": "Stores debt and receivable records for the user"
    },
    "/users/{userId}/audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Immutable audit trail records for changes performed by the user"
    }
  }
}
